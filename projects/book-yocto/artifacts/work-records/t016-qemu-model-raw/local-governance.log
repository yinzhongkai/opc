$qeProofFinal = @'
from pathlib import Path
import subprocess,json,hashlib
def git(*args):
 r=subprocess.run(['git',*args],stdout=subprocess.PIPE,stderr=subprocess.PIPE,check=True)
 return r.stdout
head=git('rev-parse','HEAD').decode().strip()
assert head=='0eede3b58c6f5a972b35c59eb5d329d5e55d5179',head
task='projects/book-yocto/TASKS.md'
old=git('show',head+':'+task).replace(b'\r\n',b'\n')
new=Path(task).read_bytes().replace(b'\r\n',b'\n')
a='### T-016 QEMU 实施阶段'.encode('utf-8')
b='### 本轮评审：A-005 v0.1'.encode('utf-8')
assert old[:old.index(a)]==new[:new.index(a)]
assert old[old.index(b,old.index(a)):]==new[new.index(b,new.index(a)):]
index='projects/book-yocto/artifacts/README.md'
oldi=git('show',head+':'+index).replace(b'\r\n',b'\n')
newi=Path(index).read_bytes().replace(b'\r\n',b'\n')
start='## T-016 QEMU 工程阶段交付（qemu-engineer）'.encode('utf-8')
end='## 正文元信息样式'.encode('utf-8')
assert newi[:newi.index(start)]+newi[newi.index(end,newi.index(start)):]==oldi
for f in ['A-005-tiger-platform-design.md','A-006-chapter4-blueprint.md']:
 p='projects/book-yocto/artifacts/'+f
 assert Path(p).read_bytes().replace(b'\r\n',b'\n')==git('show',head+':'+p).replace(b'\r\n',b'\n')
assert git('rev-parse','16467c0a8c667d3eabd59f026ceee5bc72a6584d:projects/book-yocto/artifacts/A-006-chapter4-blueprint.md').decode().strip()=='39b27c85411e93af0bd1fe02cc48b45cb6b7ce63'
base=Path('projects/book-yocto/artifacts/work-records/t016-qemu-model-raw')
manifest=json.loads((base/'manifest.json').read_text(encoding='utf-8'))
for x in manifest['bundles']:
 d=(base/x['name']).read_bytes()
 assert len(d)==x['bytes'] and hashlib.sha256(d).hexdigest()==x['sha256'],x['name']
assert len(manifest['sources'])==263
assert len(manifest['summary']['final_results'])==16
assert all(x['status']=='pass' for x in manifest['summary']['final_results'])
print('TASKS own-stage-only; original opinions/author replies/reviews and other tasks unchanged.')
print('Index existing content unchanged; fixed A-005/A-006 unchanged.')
print('9 raw bundles match byte count/SHA256; 263 source records and 16 passing final cases verified.')
print('OPC start HEAD',head)

'@
$qeProofFinal | python -X utf8 -B -
