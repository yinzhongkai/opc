G_DIR_HOST\": \"/home/oops/workspace/build-t016-yocto/tmp/work/tiger-poky-linux/tiger-minboot/0.1/recipe-sysroot\"\n    },\n    \"configuration_sha256\": \"b1218db0a43435e2893340cb5f7117f90d20b51435e2964fe3b232d1996508c0\"\n  },\n  \"helper_version\": \"QEMU emulator version 8.2.7\\nCopyright (c) 2003-2023 Fabrice Bellard and the QEMU Project developers\\n\",\n  \"helper_sha256\": \"1f05c31da60eb777e59b07f5075a143a07281b0d5b5473fac2b763a93bfdb002\",\n  \"build_binary_sha256\": \"37373f8cd717cf873976625e27571b8b06867b37ba987f2c7dd7cc551f8bffa5\",\n  \"manifest_sha256\": \"1a478c87019ffc1eb89ba1473864bc6fd61c50094f6672fb04d0f3b8669fda07\",\n  \"manifest\": {\n    \"build_id\": \"sha256:7fbb005bd53a3f3fa2ed0a933181e50db7a6bff97cab78ce9429557ccb9818d7\",\n    \"source_revision\": \"b303ae6d614f067e11d4cbba57feacaf84ee7e8e\",\n    \"compiler\": [\n      \"aarch64-poky-linux-gcc\",\n      \"-mcpu=cortex-a53+crc\",\n      \"-mbranch-protection=standard\",\n      \"-fstack-protector-strong\",\n      \"-O2\",\n      \"-D_FORTIFY_SOURCE=2\",\n      \"-Wformat\",\n      \"-Wformat-security\",\n      \"-Werror=format-security\",\n      \"--sysroot=/home/oops/workspace/build-t016-yocto/tmp/work/tiger-poky-linux/tiger-minboot/0.1/recipe-sysroot\"\n    ],\n    \"compiler_version\": \"aarch64-poky-linux-gcc (GCC) 13.4.0\\nCopyright (C) 2023 Free Software Foundation, Inc.\\nThis is free software; see the source for copying conditions.  There is NO\\nwarranty; not even for MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.\\n\\n\",\n    \"flags\": [\n      \"-O2\",\n      \"-Wall\",\n      \"-Wextra\",\n      \"-Werror\",\n      \"-march=armv8-a\",\n      \"-mgeneral-regs-only\",\n      \"-mstrict-align\",\n      \"-ffreestanding\",\n      \"-fno-builtin\",\n      \"-fno-stack-protector\",\n      \"-fno-pie\",\n      \"-fno-pic\",\n      \"-fno-unwind-tables\",\n      \"-fno-asynchronous-unwind-tables\",\n      \"-nostdlib\",\n      \"-nostartfiles\",\n      \"-static\",\n      \"-