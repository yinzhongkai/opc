d\n#!/bin/bash\nrealpath=\\`readlink -fn \\$0\\`\nrealdir=\\`dirname \\$realpath\\`\nexport $exportstring\nexec -a \"\\$0\" \\$realdir/$cmdname.real \"\\$@\"\nEND\n\tchmod +x $cmd\n}\n\n# line: 41, file: /home/oops/workspace/poky/meta/classes-global/base.bbclass\noe_runmake() {\n\toe_runmake_call \"$@\" || die \"oe_runmake failed\"\n}\n\n# line: 32, file: /home/oops/workspace/poky/meta/classes-global/base.bbclass\ndie() {\n\tbbfatal_log \"$*\"\n}\n\n# line: 36, file: /home/oops/workspace/poky/meta/classes-global/base.bbclass\noe_runmake_call() {\n\tbbnote make -j 8  LD='ld ' AR='ar' OBJCOPY='objcopy' LDFLAGS='-L/home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-system-native/8.2.7/recipe-sysroot-native/usr/lib                         -L/home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-system-native/8.2.7/recipe-sysroot-native/lib                         -Wl,--enable-new-dtags                         -Wl,-rpath-link,/home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-system-native/8.2.7/recipe-sysroot-native/usr/lib                         -Wl,-rpath-link,/home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-system-native/8.2.7/recipe-sysroot-native/lib                         -Wl,-rpath,/home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-system-native/8.2.7/recipe-sysroot-native/usr/lib                         -Wl,-rpath,/home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-system-native/8.2.7/recipe-sysroot-native/lib                         -Wl,-O1 -fuse-ld=bfd' \"$@\"\n\tmake -j 8  LD='ld ' AR='ar' OBJCOPY='objcopy' LDFLAGS='-L/home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-system-native/8.2.7/recipe-sysroot-native/usr/lib                         -L/home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-system-native/8.2.7/recipe-sysroot-native/lib                         -Wl,--enable-new-dtags                         -Wl,-rpath-link,/home/oops/workspace/build-t