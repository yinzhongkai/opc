B_PC=0xc0 GDB_SP=0x40020000 GDB_PSTATE=0x600003cd\\nGDB_DATA=0x1122334455667788\\nGDB_BSS=0x0\\n[Inferior 1 (process 1) detached]\\n\"\n    },\n    {\n      \"label\": \"warm-2\",\n      \"rc\": 0,\n      \"output\": \"0x0000000000000000 in _start ()\\nHardware assisted breakpoint 1 at 0xc0\\n\\nBreakpoint 1, 0x00000000000000c0 in firmware_main ()\\nGDB_PC=0xc0 GDB_SP=0x40020000 GDB_PSTATE=0x600003cd\\nGDB_DATA=0x1122334455667788\\nGDB_BSS=0x0\\n[Inferior 1 (process 1) detached]\\n\"\n    }\n  ],\n  \"qemu_sha256\": \"1f05c31da60eb777e59b07f5075a143a07281b0d5b5473fac2b763a93bfdb002\",\n  \"firmware_sha256\": \"092517d50dfac35b0697f3ec4819e3a3cac351d433a6e537ca4ffea52e7210cb\",\n  \"configuration_sha256\": \"b1218db0a43435e2893340cb5f7117f90d20b51435e2964fe3b232d1996508c0\",\n  \"runqemu_sha256\": \"d644b4763b968414649f948151d51ff84b1663218ffd4abae3b58d19e4ba7861\",\n  \"qemu_pid\": 997810,\n  \"actual_argv\": [\n    \"/home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-helper-native/1.0/recipe-sysroot-native/usr/bin/qemu-system-aarch64\",\n    \"-nic\",\n    \"none\",\n    \"-machine\",\n    \"tiger\",\n    \"-accel\",\n    \"tcg\",\n    \"-cpu\",\n    \"cortex-a53\",\n    \"-smp\",\n    \"1\",\n    \"-m\",\n    \"1024\",\n    \"-S\",\n    \"-qmp\",\n    \"unix:/home/oops/workspace/build-t016-yocto/evidence/runqemu-recovery-3/qmp.sock,server=on,wait=off\",\n    \"-gdb\",\n    \"tcp:127.0.0.1:57317\",\n    \"-d\",\n    \"in_asm,guest_errors\",\n    \"-D\",\n    \"/home/oops/workspace/build-t016-yocto/evidence/runqemu-recovery-3/instructions.log\",\n    \"-trace\",\n    \"enable=pl011_*\",\n    \"-serial\",\n    \"mon:stdio\",\n    \"-serial\",\n    \"null\",\n    \"-nographic\",\n    \"-bios\",\n    \"/home/oops/workspace/build-t016-yocto/tmp/deploy/images/tiger/tiger-minboot-0.1-tiger.bin\"\n  ],\n  \"qemu_exe\": \"/home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-helper-native/1.0/recipe-sysroot-native/usr/bin/qemu-system-aarch64\",\n  \"launcher_exit_code\": 0,\n  \"status\": \"pass\",\n  \"final_launcher_returncode\": 0\n}\n"
