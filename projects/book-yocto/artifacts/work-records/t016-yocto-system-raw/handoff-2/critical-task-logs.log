x86_64-linux/qemu-helper-native/1.0/recipe-sysroot-native/usr/bin\"\nexport datadir=\"/home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-helper-native/1.0/recipe-sysroot-native/usr/share\"\nexport docdir=\"/home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-helper-native/1.0/recipe-sysroot-native/usr/share/doc\"\nexport exec_prefix=\"/home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-helper-native/1.0/recipe-sysroot-native/usr\"\nexport includedir=\"/home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-helper-native/1.0/recipe-sysroot-native/usr/include\"\nexport infodir=\"/home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-helper-native/1.0/recipe-sysroot-native/usr/share/info\"\nexport libdir=\"/home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-helper-native/1.0/recipe-sysroot-native/usr/lib\"\nexport libexecdir=\"/home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-helper-native/1.0/recipe-sysroot-native/usr/libexec\"\nexport localstatedir=\"/home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-helper-native/1.0/recipe-sysroot-native/var\"\nexport lt_cv_sys_lib_dlsearch_path_spec=\"/home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-helper-native/1.0/recipe-sysroot-native/usr/lib /home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-helper-native/1.0/recipe-sysroot-native/lib /lib /lib64 /usr/lib /usr/lib64\"\nexport mandir=\"/home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-helper-native/1.0/recipe-sysroot-native/usr/share/man\"\nexport nonarch_base_libdir=\"/home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-helper-native/1.0/recipe-sysroot-native/lib\"\nexport nonarch_libdir=\"/home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-helper-native/1.0/recipe-sysroot-native/usr/lib\"\nexport prefix=\"/home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-helper-native/1.0/recipe-sysroot-native/usr\"\nexport sbindir=\"/home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-helper-native/1.0/recipe-sysroot-native/usr/sbin\"\nexport servicedir=\"/home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-helper-native/1.0/recipe-sysroot-native/srv\"\nexport sharedstatedir=\"/home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-helper-native/1.0/recipe-sysroot-native/com\"\nexport sysconfdir=\"/home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-helper-native/1.0/recipe-sysroot-native/etc\"\nexport systemd_system_unitdir=\"/home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-helper-native/1.0/recipe-sysroot-native/lib/systemd/system\"\nexport systemd_unitdir=\"/home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-helper-native/1.0/recipe-sysroot-native/lib/systemd\"\nexport systemd_user_unitdir=\"/home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-helper-native/1.0/recipe-sysroot-native/usr/lib/systemd/user\"\n\n# line: 17, file: /home/oops/workspace/poky/meta/recipes-devtools/qemu/qemu-helper-native_1.0.bb\ndo_install() {\n\tinstall -d /home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-helper-native/1.0/image/home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-helper-native/1.0/recipe-sysroot-native/usr/bin\n\tinstall qemu-oe-bridge-helper /home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-helper-native/1.0/image/home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-helper-native/1.0/recipe-sysroot-native/usr/bin/\n}\n\ncd '/home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-helper-native/1.0'\ndo_install\n\n# cleanup\nret=$?\ntrap '' 0\nexit $ret\n"
