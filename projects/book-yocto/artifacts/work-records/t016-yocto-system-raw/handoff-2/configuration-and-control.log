    "text": "#!/bin/bash\nset -eo pipefail\nexec > >(tee /home/oops/workspace/build-t016-yocto/evidence/build-2.log) 2>&1\ndate --iso-8601=seconds\nsource /home/oops/workspace/poky/oe-init-build-env /home/oops/workspace/build-t016-yocto\nbitbake-layers show-appends > evidence/show-appends-2.log\nbitbake -e qemu-system-native > evidence/qemu-env-2.log\nbitbake -e tiger-minboot > evidence/fixture-env-2.log\nbitbake -g tiger-minboot > evidence/graph-2.log\ncp task-depends.dot evidence/task-depends-2.dot\ncp pn-buildlist evidence/pn-buildlist-2.txt\nbitbake tiger-minboot\ndate --iso-8601=seconds\nbitbake -m\n"
