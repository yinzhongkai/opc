\": [\n        \"/home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-helper-native/1.0/recipe-sysroot-native/usr/bin/qemu-system-aarch64\",\n        \"-machine\",\n        \"tiger\",\n        \"-accel\",\n        \"tcg\",\n        \"-cpu\",\n        \"cortex-a53\",\n        \"-smp\",\n        \"1\",\n        \"-m\",\n        \"1024,maxmem=2G,slots=1\",\n        \"-display\",\n        \"none\",\n        \"-monitor\",\n        \"none\",\n        \"-nic\",\n        \"none\",\n        \"-serial\",\n        \"file:/home/oops/workspace/build-t016-yocto/evidence/model-2/ram-hotplug/uart.log\",\n        \"-d\",\n        \"in_asm\",\n        \"-D\",\n        \"/home/oops/workspace/build-t016-yocto/evidence/model-2/ram-hotplug/instructions.log\",\n        \"-bios\",\n        \"/home/oops/workspace/build-t016-yocto/fixture-view/tiger-minboot.bin\"\n      ],\n      \"exit_code\": 1,\n      \"output\": \"qemu-system-aarch64: tiger: RAM must be exactly 1024 MiB without hotplug\\n\",\n      \"instruction_bytes\": 0\n    }\n  },\n  {\n    \"name\": \"wrong-accelerator\",\n    \"status\": \"pass\",\n    \"details\": {\n      \"argv\": [\n        \"/home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-helper-native/1.0/recipe-sysroot-native/usr/bin/qemu-system-aarch64\",\n        \"-machine\",\n        \"tiger\",\n        \"-accel\",\n        \"qtest\",\n        \"-cpu\",\n        \"cortex-a53\",\n        \"-smp\",\n        \"1\",\n        \"-m\",\n        \"1024\",\n        \"-display\",\n        \"none\",\n        \"-monitor\",\n        \"none\",\n        \"-nic\",\n        \"none\",\n        \"-serial\",\n        \"file:/home/oops/workspace/build-t016-yocto/evidence/model-2/wrong-accelerator/uart.log\",\n        \"-d\",\n        \"in_asm\",\n        \"-D\",\n        \"/home/oops/workspace/build-t016-yocto/evidence/model-2/wrong-accelerator/instructions.log\",\n        \"-bios\",\n        \"/home/oops/workspace/build-t016-yocto/fixture-view/tiger-minboot.bin\"\n      ],\n      \"exit_code\": 1,\n      \"output\": \"qemu-system-aarch64: tiger: only the TCG accelerator is supported\\n\",\n      \"instruction_bytes\": 0\n    }\n  },\n  {\n    \"name\": \"kernel-input\",\n    \"status\": \"pass\",\n    \"details\": {\n      \"argv\": [\n        \"/home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-helper-native/1.0/recipe-sysroot-native/usr/bin/qemu-system-aarch64\",\n        \"-machine\",\n        \"tiger\",\n        \"-accel\",\n        \"tcg\",\n        \"-cpu\",\n        \"cortex-a53\",\n        \"-smp\",\n        \"1\",\n        \"-m\",\n        \"1024\",\n        \"-display\",\n        \"none\",\n        \"-monitor\",\n        \"none\",\n        \"-nic\",\n        \"none\",\n        \"-serial\",\n        \"file:/home/oops/workspace/build-t016-yocto/evidence/model-2/kernel-input/uart.log\",\n        \"-d\",\n        \"in_asm\",\n        \"-D\",\n        \"/home/oops/workspace/build-t016-yocto/evidence/model-2/kernel-input/instructions.log\",\n        \"-bios\",\n        \"/home/oops/workspace/build-t016-yocto/fixture-view/tiger-minboot.bin\",\n        \"-kernel\",\n        \"/home/oops/workspace/build-t016-yocto/fixture-view/tiger-minboot.bin\"\n      ],\n      \"exit_code\": 1,\n      \"output\": \"qemu-system-aarch64: tiger: kernel, initrd and DTB inputs are unsupported\\n\",\n      \"instruction_bytes\": 0\n    }\n  },\n  {\n    \"name\": \"initrd-input\",\n    \"status\": \"pass\",\n    \"details\": {\n      \"argv\": [\n        \"/home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-helper-native/1.0/recipe-sysroot-native/usr/bin/qemu-system-aarch64\",\n        \"-machine\",\n        \"tiger\",\n        \"-accel\",\n        \"tcg\",\n        \"-cpu\",\n        \"cortex-a53\",\n        \"-smp\",\n        \"1\",\n        \"-m\",\n        \"1024\",\n        \"-display\",\n        \"none\",\n        \"-monitor\",\n        \"none\",\n        \"-nic\",\n        \"none\",\n        \"-serial\",\n        \"file:/home/oops/workspace/build-t016-yocto/evidence/model-2/initrd-input/uart.log\",\n        \"-d\",\n        \"in_asm\",\n        \"-D\",\n        \"/home/oops/workspace/build-t016-yocto/evidence/model-2/initrd-input/instructions.log\",\n        \"-bios\",\n        \"/home/oops/workspace/build-t016-yocto/fixture-view/tiger-minboot.bin\",\n        \"-initrd\",\n        \"/home/oops/workspace/build-t016-yocto/fixture-view/tiger-minboot.bin\"\n      ],\n      \"exit_code\": 1,\n      \"output\": \"qemu-system-aarch64: -initrd only allowed with -kernel option\\n\",\n      \"instruction_bytes\": 0\n    }\n  },\n  {\n    \"name\": \"dtb-input\",\n    \"status\": \"pass\",\n    \"details\": {\n      \"argv\": [\n        \"/home/oops/workspace/build-t016-yocto/tmp/work/x86_64-linux/qemu-helper-native/1.0/recipe-sysroot-native/usr/bin/qemu-system-aarch64\",\n        \"-machine\",\n        \"tiger\",\n        \"-accel\",\n        \"tcg\",\n        \"-cpu\",\n        \"cortex-a53\",\n        \"-smp\",\n        \"1\",\n        \"-m\",\n        \"1024\",\n        \"-display\",\n        \"none\",\n        \"-monitor\",\n        \"none\",\n        \"-nic\",\n        \"none\",\n        \"-serial\",\n        \"file:/home/oops/workspace/build-t016-yocto/evidence/model-2/dtb-input/uart.log\",\n        \"-d\",\n        \"in_asm\",\n        \"-D\",\n        \"/home/oops/workspace/build-t016-yocto/evidence/model-2/dtb-input/instructions.log\",\n        \"-bios\",\n        \"/home/oops/workspace/build-t016-yocto/fixture-view/tiger-minboot.bin\",\n        \"-dtb\",\n        \"/home/oops/workspace/build-t016-yocto/fixture-view/tiger-minboot.bin\"\n      ],\n      \"exit_code\": 1,\n      \"output\": \"qemu-system-aarch64: tiger: kernel, initrd and DTB inputs are unsupported\\n\",\n      \"instruction_bytes\": 0\n    }\n  }\n]\n"
