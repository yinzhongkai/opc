111:SSIBus *ssi_create_bus(DeviceState *parent, const char *name);
112:
113:uint32_t ssi_transfer(SSIBus *bus, uint32_t val);
114:
115:DeviceState *ssi_get_cs(SSIBus *bus, uint8_t cs_index);
