  data=(root/f).read_bytes()
  upstream=tf.extractfile('qemu-8.2.7/'+f).read()
  print('PROVENANCE',f,'SHA256',hashlib.sha256(data).hexdigest(),'ARCHIVE_EQUAL',data==upstream)
lines=(root/'hw/arm/virt.c').read_text().splitlines()
