FILESEXTRAPATHS:prepend := "${THISDIR}/${PN}:"
FILESPATH:prepend := "/home/oops/workspace/build/workspace/sources/qemu-system-native/oe-local-files:"
# srctreebase: /home/oops/workspace/build/workspace/sources/qemu-system-native

inherit externalsrc
# NOTE: We use pn- overrides here to avoid affecting multiple variants in the case where the recipe uses BBCLASSEXTEND
EXTERNALSRC:pn-qemu-system-native = "/home/oops/workspace/build/workspace/sources/qemu-system-native"

