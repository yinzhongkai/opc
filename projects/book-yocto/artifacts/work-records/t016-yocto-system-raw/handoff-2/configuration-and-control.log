[
  {
    "path": "/home/oops/workspace/build-t016-yocto/audit-assets.py",
    "bytes": 4537,
    "sha256": "bfd067acb31d0a341c82939ea945640f7b435dd0a5d794faf72916f2da5ee29e",
    "text": "#!/usr/bin/env python3\nfrom pathlib import Path\nimport configparser\nimport hashlib\nimport json\nimport os\nimport re\nimport shutil\nimport subprocess\n\nb = Path(\"/home/oops/workspace/build-t016-yocto\")\ne = b / \"evidence\"\ndeploy = b / \"tmp/deploy/images/tiger\"\nasset = \"tiger-minboot-0.1-tiger\"\n\ndef sha(path):\n    return hashlib.sha256(Path(path).read_bytes()).hexdigest()\n\ndef env(name):\n    return dict(re.findall(r'^([A-Za-z0-9_:+.-]+)=\"(.*)\"$', (e / name).read_text(), re.M))\n\nqenv, fenv = env(\"qemu-env-2.log\"), env(\"fixture-env-2.log\")\nmanifest_path = deploy / (asset + \"-manifest.json\")\nmanifest = json.loads(manifest_path.read_text())\nnative = json.loads((deploy / (asset + \"-native-identity.json\")).read_text())\nconf_path = deploy / (asset + \".qemuboot.conf\")\ncp = configparser.ConfigParser(interpolation=None)\ncp.read(conf_path)\ncfg = cp[\"config_bsp\"]\nfor key in (\"qb_default_kernel\", \"qb_default_fstype\", \"qb_rootfs\"):\n    assert cfg[key] == \"none\"\nassert cfg[\"machine\"] == \"tiger\" and cfg[\"tune_arch\"] == \"aarch64\"\nassert cfg[\"deploy_dir_image\"] == \".\"\nassert cfg[\"qb_default_bios\"] == asset + \".bin\"\nfor key in (\"qb_rng\", \"qb_graphics\", \"qb_opt_append\", \"qb_rootfs_opt\",\n            \"qb_network_device\", \"qb_tap_opt\", \"qb_tcpserial_opt\", \"qb_serial_opt\",\n            \"serial_consoles\", \"qb_cpu_kvm\", \"qb_kernel_cmdline_append\"):\n    assert not cfg[key], (key, cfg[key])\nfor key, path in native[\"paths\"].items():\n    assert (conf_path.parent / cfg[key.lower()]).resolve() == Path(path), (key, path)\n    assert Path(path).is_dir(), path\nhelper = Path(native[\"qemu_path\"])\nassert helper.is_file() and os.access(helper, os.X_OK)\nassert sha(helper) == native[\"qemu_sha256\"]\nassert sha(conf_path) == native[\"configuration_sha256\"]\nfiles = {}\nfor name, identity in manifest[\"outputs\"].items():\n    if name.startswith(\"tiger-minboot.\"):\n        published = deploy / (asset + name.removeprefix(\"tiger-minboot\"))\n    else:\n        published = deploy / (asset + \"-\" + name)\n    assert published.stat().st_size == identity[\"bytes\"], published\n    assert sha(published) == identity[\"sha256\"], published\n    files[str(published)] = identity\nfor name, digest in manifest[\"source_files\"].items():\n    assert sha(Path(fenv[\"S\"]) / name) == digest, name\nview = b / \"fixture-view\"\nview.mkdir(exist_ok=True)\nfor name, target in ((\"tiger-minboot.bin\", deploy / (asset + \".bin\")),\n                     (\"tiger-minboot.elf\", deploy / (asset + \".elf\")),\n                     (\"manifest.json\", manifest_path)):\n    link = view / name\n    if link.exists() or link.is_symlink():\n        assert link.is_symlink() and link.resolve() == target.resolve(), link\n    else:\n        link.symlink_to(target)\nscript = Path(fenv[\"B\"]).parent / \"temp/log.do_compile\"\nrun_script = Path(fenv[\"B\"]).parent / \"temp/run.do_compile\"\npath_values = re.findall(r'^export PATH=\"([^\"]+)\"', run_script.read_text(), re.M)\nassert path_values, run_script\ncommands = json.loads((deploy / (asset + \"-commands.json\")).read_text())\ntools = {}\nfor command in commands:\n    name = command[\"argv\"][0]\n    resolved = shutil.which(name, path=path_values[-1])\n    assert resolved, name\n    tools[name] = {\"path\": resolved, \"realpath\": str(Path(resolved).resolve()),\n                   \"sha256\": sha(resolved)}\nversion = subprocess.check_output([str(helper), \"--version\"], text=True)\nhelp_text = subprocess.check_output([str(helper), \"-machine\", \"help\"], text=True)\nassert re.search(r'^tiger\\s', help_text, re.M), help_text\n(e / \"helper-machine-help.log\").write_text(help_text)\nhost = Path(qenv[\"B\"]) / \"config-host.mak\"\nhost_text = host.read_text()\nassert \"/home/oops/workspace/sources/qemu-system-native\" not in host_text\n(e / \"config-host.mak.txt\").write_text(host_text)\nrecord = {\"status\": \"pass\", \"deploy\": str(deploy), \"fixture_view\": str(view),\n          \"configuration\": dict(cfg), \"native\": native,\n          \"helper_version\": version, \"helper_sha256\": sha(helper),\n          \"build_binary_sha256\": sha(Path(qenv[\"B\"]) / \"qemu-system-aarch64\"),\n          \"manifest_sha256\": sha(manifest_path), \"manifest\": manifest,\n          \"tools\": tools, \"outputs\": files,\n          \"tun_writable\": os.access(\"/dev/net/tun\", os.W_OK)}\nrecord[\"package_sha256\"] = sha(\"/home/oops/workspace/build/downloads/qemu-8.2.7.tar.xz\")\nassert record[\"package_sha256\"] == \"1f0604f296ab9acb4854c054764a1ba408643fc299bd54a6500cccfaaca65b55\"\nassert record[\"tun_writable\"], \"/dev/net/tun is not writable\"\n(e / \"asset-audit.json\").write_text(json.dumps(record, indent=2) + \"\\n\")\nprint(json.dumps(record, indent=2))\n"
  },
