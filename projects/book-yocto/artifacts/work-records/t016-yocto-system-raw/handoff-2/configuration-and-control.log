    "text": "#!/bin/bash\nset -eo pipefail\nexec > >(tee /home/oops/workspace/build-t016-yocto/evidence/build-1.log) 2>&1\ndate --iso-8601=seconds\nsource /home/oops/workspace/poky/oe-init-build-env /home/oops/workspace/build\nbitbake -e qemu-system-native > /home/oops/workspace/build-t016-yocto/evidence/override-before.log\ndevtool status\ndevtool reset -n qemu-system-native\ndevtool status\nbitbake -e qemu-system-native > /home/oops/workspace/build-t016-yocto/evidence/override-after.log\ngit -C /home/oops/workspace/sources/qemu-system-native status --short --branch\ngit -C /home/oops/workspace/sources/qemu-system-native rev-parse HEAD\nbitbake -m\nsource /home/oops/workspace/poky/oe-init-build-env /home/oops/workspace/build-t016-yocto\nbitbake tiger-minboot\ndate --iso-8601=seconds\nbitbake -m\n"
