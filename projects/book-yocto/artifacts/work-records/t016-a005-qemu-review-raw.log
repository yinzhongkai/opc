76:    .size       = sizeof(SSIPeripheral),                             \
77:    .vmsd       = &vmstate_ssi_peripheral,                           \
78:    .flags      = VMS_STRUCT,                                        \
79:    .offset     = vmstate_offset_value(_state, _field, SSIPeripheral), \
80:}
