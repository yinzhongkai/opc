  {
    "path": "/home/oops/workspace/build-t016-yocto/close-stage.py",
    "bytes": 7702,
    "sha256": "8822d799af5a4eb50bd0c634a185a761464c3fd61d072c5f43595fccdd30fd6a",
    "text": "#!/usr/bin/env python3\nfrom pathlib import Path\nimport ast\nimport datetime\nimport hashlib\nimport json\nimport os\nimport re\nimport subprocess\n\nb = Path(\"/home/oops/workspace/build-t016-yocto\")\ne = b / \"evidence\"\nm = Path(\"/home/oops/workspace/meta-tiger\")\np = Path(\"/home/oops/workspace/poky\")\ns = Path(\"/home/oops/workspace/sources/qemu-system-native\")\n\ndef git(root, *args):\n    return subprocess.check_output([\"git\", *args], cwd=root, text=True)\ndef sha(path):\n    return hashlib.sha256(Path(path).read_bytes()).hexdigest()\ndef env(name):\n    return dict(re.findall(r'^([A-Za-z0-9_:+.-]+)=\"(.*)\"$', (e/name).read_text(), re.M))\n\nassert (e/\"build-2.rc\").read_text().strip() == \"0\"\nassert (e/\"system-3.rc\").read_text().strip() == \"0\"\nassert git(m, \"rev-parse\", \"HEAD\").strip() == \"4dd7dfda8f2af2d59bdcfe6585418cf43eaa73e8\"\nassert git(m, \"rev-parse\", \"master\").strip() == \"0e3da48b34ef772532535a730a21878cc30ccf67\"\nassert not git(m, \"status\", \"--porcelain=v1\").strip()\nassert git(p, \"rev-parse\", \"HEAD\").strip() == \"77d1feb37e280733684ae8a9449fb031d5d7ff40\"\nassert not git(p, \"status\", \"--porcelain=v1\").strip()\nassert not git(m, \"rev-list\", \"--merges\", \"b303ae6d614f067e11d4cbba57feacaf84ee7e8e..HEAD\").strip()\nchanged = git(m, \"diff\", \"--name-only\", \"cd6c348836346004e801cb13f32ad3fcb12c1dfd..HEAD\").splitlines()\nassert set(changed) == {\"tests/integration/README.md\", \"tests/integration/test-deployment.py\"}\nprotected = [\"recipes-devtools/qemu/files/0001-arm-add-minimal-tiger-machine.patch\",\n             \"recipes-test/tiger-minboot/files/start.S\", \"recipes-test/tiger-minboot/files/main.c\",\n             \"recipes-test/tiger-minboot/files/tiger-minboot.ld\", \"recipes-test/tiger-minboot/files/COPYING.MIT\",\n             \"tests/model\"]\nassert not git(m, \"diff\", \"--name-only\", \"b303ae6d614f067e11d4cbba57feacaf84ee7e8e..HEAD\", \"--\", *protected).strip()\n\nbefore = json.loads((e/\"source-before.json\").read_text())\nafter = {\"source_head\":git(s,\"rev-parse\",\"HEAD\").strip(),\n         \"source_status\":git(s,\"status\",\"--porcelain=v1\"),\n         \"refs\":git(s,\"show-ref\"),\n         \"bundle_sha256\":sha(s/\".git/opc-retention/20261017/qemu-system-native-all-refs.bundle\")}\nassert after == before\nalias = Path(\"/home/oops/workspace/build/workspace/sources/qemu-system-native\")\nassert alias.is_symlink() and alias.resolve() == s\nassert not list(Path(\"/home/oops/workspace/build/workspace/appends\").glob(\"qemu-system-native*.bbappend\"))\nqenv, fenv = env(\"qemu-env-2.log\"), env(\"fixture-env-2.log\")\nassert not qenv.get(\"EXTERNALSRC\") and not qenv.get(\"EXTERNALSRC_BUILD\")\nassert qenv[\"QEMU_TARGETS\"] == \"aarch64\" and qenv[\"MACHINE\"] == \"tiger\"\nassert not {\"sdl\",\"virglrenderer\",\"epoxy\",\"kvm\"} & set(qenv[\"PACKAGECONFIG\"].split())\nassert \"workspace\" not in (b/\"conf/bblayers.conf\").read_text().replace(\"/home/oops/workspace/\", \"\")\ngraph = (e/\"task-depends-2.dot\").read_text()\nedges = ['\"tiger-minboot.do_deploy\" -> \"tiger-minboot.do_generate_qemuboot\"',\n         '\"tiger-minboot.do_generate_qemuboot\" -> \"qemu-helper-native.do_addto_recipe_sysroot\"',\n         '\"tiger-minboot.do_generate_qemuboot\" -> \"tiger-minboot.do_compile\"']\nassert all(x in graph for x in edges)\nsig = (e/\"generate-signature-2.log\").read_text()\ndeps = ast.literal_eval(re.search(r\"^Task dependencies: (.*)$\",sig,re.M).group(1))\nrequired = [x for x in fenv if x.startswith(\"QB_\") and x in\n            (\"QB_SYSTEM_NAME\",\"QB_MACHINE\",\"QB_CPU\",\"QB_SMP\",\"QB_MEM\",\"QB_DEFAULT_KERNEL\",\n             \"QB_DEFAULT_FSTYPE\",\"QB_ROOTFS\",\"QB_DEFAULT_BIOS\",\"QB_NET\",\"QB_KERNEL_CMDLINE\",\n             \"QB_RNG\",\"QB_GRAPHICS\",\"QB_OPT_APPEND\",\"QB_ROOTFS_OPT\",\"QB_NETWORK_DEVICE\",\n             \"QB_TAP_OPT\",\"QB_TCPSERIAL_OPT\",\"QB_SERIAL_OPT\",\"QB_CPU_KVM\",\"QB_KERNEL_CMDLINE_APPEND\")]\nrequired += [\"SERIAL_CONSOLES\",\"MACHINE\",\"TUNE_ARCH\",\"DEPLOY_DIR_IMAGE\",\"BASE_WORKDIR\",\"BUILD_SYS\",\"RECIPE_SYSROOT\"]\nassert set(required) <= set(deps)\nassert json.loads((e/\"formal-patch-check.json\").read_text())[\"status\"] == \"pass\"\naudit = json.loads((e/\"asset-audit.json\").read_text())\nassert audit[\"status\"] == \"pass\"\nruntime = {}\nfor name in (\"runqemu-2\",\"runqemu-recovery-3\"):\n    st = json.loads((e/name/\"state.json\").read_text())\n    assert st[\"status\"] == \"pass\" and st[\"launcher_exit_code\"] == 0 and st[\"final_launcher_returncode\"] == 0\n    assert st[\"qemu_sha256\"] == audit[\"helper_sha256\"] == sha(st[\"qemu_exe\"])\n    assert st[\"firmware_sha256\"] == sha(Path(audit[\"deploy\"])/\"tiger-minboot-0.1-tiger.bin\")\n    assert st[\"configuration_sha256\"] == audit[\"native\"][\"configuration_sha256\"]\n    markers = [l for l in (e/name/\"runqemu.log\").read_text().splitlines() if l.startswith(\"TIGER-CH4\")]\n    assert len(markers) == 3\n    assert len(st[\"gdb\"]) == 3 and all(x[\"rc\"] == 0 for x in st[\"gdb\"])\n    runtime[name] = {k:st[k] for k in (\"status\",\"launcher_pid\",\"qemu_pid\",\"qemu_exe\",\"actual_argv\",\n                     \"launcher_exit_code\",\"final_launcher_returncode\",\"qemu_sha256\",\"configuration_sha256\")}\n    runtime[name][\"markers\"] = markers\n    runtime[name][\"reset_snapshots\"] = [x for x in st[\"snapshots\"] if \"before\" in x[\"label\"]]\n    assert not Path(\"/proc/%s\"%st[\"qemu_pid\"]).exists()\nmodel = json.loads((e/\"model-2/results.json\").read_text())\nassert len(model) == 16 and all(x[\"status\"] == \"pass\" for x in model)\ndeployment = json.loads((e/\"deployment-3/results.json\").read_text())\nassert len(deployment) == 3 and all(x[\"pass\"] for x in deployment)\ntask_logs = {}\nfor recipe, directory, tasks in (\n    (\"qemu-system-native\",Path(qenv[\"WORKDIR\"]),(\"patch\",\"configure\",\"compile\",\"install\",\"populate_sysroot\")),\n    (\"qemu-helper-native\",b/\"tmp/work/x86_64-linux/qemu-helper-native/1.0\",(\"install\",\"populate_sysroot\",\"addto_recipe_sysroot\")),\n    (\"tiger-minboot\",Path(fenv[\"WORKDIR\"]),(\"compile\",\"generate_qemuboot\",\"deploy\"))):\n    task_logs[recipe] = {}\n    for task in tasks:\n        logs = [x for x in (directory/\"temp\").glob(\"log.do_\"+task+\".*\") if x.is_file() and not x.is_symlink()]\n        assert logs,(recipe,task)\n        task_logs[recipe][task] = [{\"path\":str(x),\"bytes\":x.stat().st_size,\"sha256\":sha(x)} for x in sorted(logs)]\nrecord = {\"status\":\"pass\",\"time\":datetime.datetime.now().isoformat(),\n          \"meta_head\":git(m,\"rev-parse\",\"HEAD\").strip(),\"meta_master\":git(m,\"rev-parse\",\"master\").strip(),\n          \"meta_status\":git(m,\"status\",\"--porcelain=v1\"),\"poky_head\":git(p,\"rev-parse\",\"HEAD\").strip(),\n          \"poky_status\":git(p,\"status\",\"--porcelain=v1\"),\"source_after\":after,\"compatibility_alias\":str(alias),\n          \"source_retained_unchanged\":True,\"model_and_firmware_source_unchanged\":True,\n          \"build_producer_head\":\"cd6c348836346004e801cb13f32ad3fcb12c1dfd\",\n          \"later_changes_only_test_and_readme\":changed,\"commits\":git(m,\"log\",\"--reverse\",\"--format=%H %s\",\"b303ae6d614f067e11d4cbba57feacaf84ee7e8e..HEAD\"),\n          \"signature_required_variables\":required,\"signature_actual_dependencies\":deps,\"graph_edges\":edges,\n          \"qemu_packageconfig\":qenv[\"PACKAGECONFIG\"],\"task_logs\":task_logs,\"runtime\":runtime,\n          \"model_results\":model,\"deployment_results\":deployment,\n          \"asset_audit_sha256\":sha(e/\"asset-audit.json\"),\n          \"returncodes\":{n:(e/n).read_text().strip() for n in (\"parse-1.rc\",\"parse-2.rc\",\"build-1.rc\",\"build-2.rc\",\"system-1.rc\",\"system-2.rc\",\"system-3.rc\")}}\n(e/\"stage-final-check.json\").write_text(json.dumps(record,indent=2)+\"\\n\")\nprint(json.dumps({\"status\":record[\"status\"],\"meta_head\":record[\"meta_head\"],\"returncodes\":record[\"returncodes\"],\n                  \"runtime_pids\":{k:v[\"qemu_pid\"] for k,v in runtime.items()},\n                  \"model_passed\":len(model),\"deployment_passed\":len(deployment),\n                  \"source_retained_unchanged\":True,\"task_logs\":task_logs},indent=2))\n"
  },
  {
    "path": "/home/oops/workspace/build-t016-yocto/collect-evidence.py",
    "bytes": 3072,
    "sha256": "0ada417f864cd18b1fccb0254cb3236561d739913b4526796aaeb5c9357e0562",
    "text": "#!/usr/bin/env python3\n\"\"\"Package complete raw text evidence; binary build artifacts stay on tiger.\"\"\"\nimport hashlib\nimport json\nfrom pathlib import Path\nimport sys\n\nbuild = Path(\"/home/oops/workspace/build-t016-yocto\")\nevidence = build / \"evidence\"\ndestination = evidence / sys.argv[1]\ndestination.mkdir(exist_ok=False)\ngroups = {}\n\ndef add(group, path):\n    path = Path(path)\n    if path.is_file() and not path.is_symlink():\n        groups.setdefault(group, set()).add(path)\n\nfor path in evidence.iterdir():\n    if path.is_file() and path.suffix in (\".log\", \".json\", \".rc\", \".pid\", \".txt\", \".dot\"):\n        add(\"configuration-and-control\", path)\nfor path in (evidence / \"override-backup\").rglob(\"*\"):\n    add(\"configuration-and-control\", path)\nfor path in (build / \"conf\").glob(\"*\"):\n    add(\"configuration-and-control\", path)\nfor path in build.glob(\"*.sh\"):\n    add(\"configuration-and-control\", path)\nfor path in build.glob(\"*.py\"):\n    add(\"configuration-and-control\", path)\nfor path in build.glob(\"tmp/work/x86_64-linux/llvm-native/18.1.8/temp/*\"):\n    if path.name.startswith((\"log.do_compile.\", \"run.do_compile.\")):\n        add(\"interrupted-dependency\", path)\nfor pattern in (\"tmp/work/x86_64-linux/qemu-system-native/8.2.7/temp/*\",\n                \"tmp/work/x86_64-linux/qemu-helper-native/1.0/temp/*\",\n                \"tmp/work/tiger-poky-linux/tiger-minboot/0.1/temp/*\"):\n    for path in build.glob(pattern):\n        if path.name.startswith((\"log.do_\", \"run.do_\")):\n            add(\"critical-task-logs\", path)\nfor path in (build / \"tmp/deploy/images/tiger\").glob(\"*\"):\n    if path.suffix in (\".txt\", \".json\", \".conf\"):\n        add(\"deployed-text-identities\", path)\nfor directory in evidence.iterdir():\n    if not directory.is_dir() or directory == destination:\n        continue\n    if directory.name.startswith((\"runqemu-\", \"model-\", \"deployment-\")):\n        for path in directory.rglob(\"*\"):\n            if path.suffix in (\".log\", \".json\", \".txt\", \".py\", \".conf\"):\n                add(directory.name, path)\nmanifest = {\"format\": \"utf8-text-records-v1\", \"groups\": {}, \"files\": []}\nfor name, paths in sorted(groups.items()):\n    rows = []\n    for path in sorted(paths):\n        data = path.read_bytes()\n        text = data.decode(\"utf-8\")\n        row = {\"path\": str(path), \"bytes\": len(data),\n               \"sha256\": hashlib.sha256(data).hexdigest(), \"text\": text}\n        assert hashlib.sha256(text.encode()).hexdigest() == row[\"sha256\"]\n        rows.append(row)\n        manifest[\"files\"].append({k: row[k] for k in (\"path\", \"bytes\", \"sha256\")})\n    output = destination / (name + \".log\")\n    output.write_text(json.dumps(rows, indent=2, ensure_ascii=True) + \"\\n\")\n    manifest[\"groups\"][output.name] = {\n        \"records\": len(rows), \"bytes\": output.stat().st_size,\n        \"sha256\": hashlib.sha256(output.read_bytes()).hexdigest()}\n(destination / \"manifest.json\").write_text(json.dumps(manifest, indent=2) + \"\\n\")\nprint(json.dumps({\"directory\": str(destination), \"records\": len(manifest[\"files\"]),\n                  \"groups\": manifest[\"groups\"]}, indent=2))\n"
  },
  {
