for p in sorted((root/'include').rglob('*.h')):
 lines=p.read_text(errors='replace').splitlines()
 hits=[(n,l) for n,l in enumerate(lines,1) if re.search(r'#define ARCH_TIMER_(NS_EL1|VIRT|NS_EL2|S_EL1)_IRQ',l)]
 if hits:
  f=str(p.relative_to(root))
  with tarfile.open(archive,'r:xz') as tf:
   upstream=tf.extractfile('qemu-8.2.7/'+f).read()
   print('PROVENANCE',f,'SHA256',hashlib.sha256(p.read_bytes()).hexdigest(),'ARCHIVE_EQUAL',p.read_bytes()==upstream)
  print('TIMER_INTID',f)
  for n,l in hits: print(str(n)+':'+l)
print('FINAL_REMOTE_BASELINE')
for repo in ['/home/oops/workspace/meta-tiger','/home/oops/workspace/poky']:
 print('REPO',repo)
