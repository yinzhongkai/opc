from pathlib import Path
import json,hashlib,subprocess,datetime
prefix="projects/book-yocto/artifacts/work-records/t016-yocto-system-raw/"
def blob(path):
 return subprocess.check_output(["git","-c","safe.directory=D:/opc-book-yocto","show",":"+path])
sha=lambda b:hashlib.sha256(b).hexdigest()
manifest_bytes=blob(prefix+"handoff-2/manifest.json")
assert sha(manifest_bytes)=="5f3e6190d3193963c3a676f945fd3f7b39998b7e45d7d4b95c8e832ddc270708"
m=json.loads(manifest_bytes);count=0
for name,expected in m["groups"].items():
 b=blob(prefix+"handoff-2/"+name)
 assert len(b)==expected["bytes"] and sha(b)==expected["sha256"],name
 rows=json.loads(b)
 assert len(rows)==expected["records"]
 for row in rows:
  b=row["text"].encode("utf-8")
  assert len(b)==row["bytes"] and sha(b)==row["sha256"],row["path"]
 count+=len(rows)
assert count==291
p=Path(prefix+"verification.json");r=json.loads(p.read_text(encoding="utf-8"))
r.update(git_index_verified_groups=9,git_index_verified_records=count,
 git_index_manifest_sha256=sha(manifest_bytes))
p.write_text(json.dumps(r,indent=2)+"\n",encoding="utf-8")
print(json.dumps({"status":"pass","indexed_groups":9,"indexed_records":count,"manifest_sha256":sha(manifest_bytes)}))

